#!/usr/bin/env python3
from __future__ import annotations

import json
import re
import sys
import tomllib
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
CLAUDE_MARKETPLACE = ROOT / ".claude-plugin" / "marketplace.json"
CODEX_MARKETPLACE = ROOT / ".agents" / "plugins" / "marketplace.json"
GEMINI_MANIFEST = ROOT / "gemini-extension.json"
GEMINI_COMMAND = ROOT / "commands" / "agent-operator" / "setup.toml"
SHARED_MANIFEST_FIELDS = (
    "name",
    "version",
    "description",
    "author",
    "repository",
    "license",
    "keywords",
    "skills",
)
SEMVER = re.compile(r"^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-[0-9A-Za-z.-]+)?(?:\+[0-9A-Za-z.-]+)?$")


def fail(message: str, errors: list[str]) -> None:
    errors.append(message)
    print(f"ERROR: {message}")


def load_json(path: Path, errors: list[str]) -> dict:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        fail(f"cannot read valid JSON from {path.relative_to(ROOT)}: {exc}", errors)
        return {}
    if not isinstance(value, dict):
        fail(f"{path.relative_to(ROOT)} must contain a JSON object", errors)
        return {}
    return value


def load_toml(path: Path, errors: list[str]) -> dict:
    try:
        value = tomllib.loads(path.read_text(encoding="utf-8"))
    except (OSError, tomllib.TOMLDecodeError) as exc:
        fail(f"cannot read valid TOML from {path.relative_to(ROOT)}: {exc}", errors)
        return {}
    if not isinstance(value, dict):
        fail(f"{path.relative_to(ROOT)} must contain a TOML table", errors)
        return {}
    return value


def plugin_entries(data: dict, label: str, errors: list[str]) -> dict[str, dict]:
    raw_entries = data.get("plugins")
    if not isinstance(raw_entries, list):
        fail(f"{label} marketplace plugins must be an array", errors)
        return {}

    entries: dict[str, dict] = {}
    for index, entry in enumerate(raw_entries):
        if not isinstance(entry, dict):
            fail(f"{label} marketplace plugin at index {index} must be an object", errors)
            continue
        name = entry.get("name")
        if not isinstance(name, str) or not name:
            fail(f"{label} marketplace plugin at index {index} has no valid name", errors)
            continue
        if name in entries:
            fail(f"{label} marketplace contains duplicate plugin {name}", errors)
            continue
        entries[name] = entry
    return entries


def check_plugin(plugin_root: Path, expected_version: str | None, errors: list[str]) -> None:
    claude_path = plugin_root / ".claude-plugin" / "plugin.json"
    codex_path = plugin_root / ".codex-plugin" / "plugin.json"
    claude = load_json(claude_path, errors)
    codex = load_json(codex_path, errors)
    name = plugin_root.name

    for label, manifest in (("Claude", claude), ("Codex", codex)):
        if manifest.get("name") != name:
            fail(f"{label} manifest name must match plugin directory {name}", errors)
        if manifest.get("skills") != "./skills/":
            fail(f"{label} manifest for {name} must declare ./skills/", errors)

    for field in SHARED_MANIFEST_FIELDS:
        if claude.get(field) != codex.get(field):
            fail(f"Claude and Codex {field} fields differ for {name}", errors)
    if not isinstance(claude.get("version"), str) or not SEMVER.fullmatch(claude["version"]):
        fail(f"plugin version is not valid semantic versioning for {name}", errors)
    if expected_version and claude.get("version") != expected_version:
        fail(f"Claude marketplace version differs from plugin version for {name}", errors)

    skills = sorted((plugin_root / "skills").glob("*/SKILL.md"))
    if not skills:
        fail(f"{name} contains no skills", errors)


def check_gemini_extension(marketplace_name: object, errors: list[str]) -> None:
    manifest = load_json(GEMINI_MANIFEST, errors)
    if manifest.get("name") != marketplace_name:
        fail("Gemini extension and marketplace names differ", errors)
    version = manifest.get("version")
    if not isinstance(version, str) or not SEMVER.fullmatch(version):
        fail("Gemini extension version is not valid semantic versioning", errors)

    context_name = manifest.get("contextFileName")
    if not isinstance(context_name, str) or not (ROOT / context_name).is_file():
        fail("Gemini extension contextFileName must reference an existing file", errors)

    authoritative_skills: dict[str, Path] = {}
    for skill_path in sorted((ROOT / "plugins").glob("*/skills/*/SKILL.md")):
        name = skill_path.parent.name
        if name in authoritative_skills:
            fail(f"duplicate authoritative skill name: {name}", errors)
            continue
        authoritative_skills[name] = skill_path

    gemini_skills = {
        path.parent.name: path for path in sorted((ROOT / "skills").glob("*/SKILL.md"))
    }
    if set(gemini_skills) != set(authoritative_skills):
        fail("Gemini skill entrypoints differ from authoritative plugin skills", errors)

    for name, source_path in authoritative_skills.items():
        wrapper_path = gemini_skills.get(name)
        if wrapper_path is None:
            continue
        expected_reference = "../../" + source_path.relative_to(ROOT).as_posix()
        if expected_reference not in wrapper_path.read_text(encoding="utf-8"):
            fail(f"Gemini skill entrypoint does not reference its source: {name}", errors)

    command = load_toml(GEMINI_COMMAND, errors)
    if not isinstance(command.get("description"), str) or not isinstance(command.get("prompt"), str):
        fail("Gemini setup command must contain string description and prompt fields", errors)
    elif "{{args}}" not in command["prompt"]:
        fail("Gemini setup command must forward user arguments", errors)

    for guide in ("README-CODEX.md", "README-CLAUDE.md", "README-COPILOT.md", "README-GEMINI.md", "LICENSE"):
        if not (ROOT / guide).is_file():
            fail(f"missing native client guide: {guide}", errors)


def check_copilot_builder_kit(errors: list[str]) -> None:
    # Copilot discovers the Claude-format catalog and manifest checked above.
    plugin_root = (ROOT / "plugins" / "builder-kit").resolve()
    skill_names = {"builder-kit", "start-new-app", "develop-from-spec", "adversarial-review", "pr-review-loop"}
    skills = sorted((plugin_root / "skills").glob("*/SKILL.md"))
    if {path.parent.name for path in skills} != skill_names:
        fail("Copilot Builder Kit skill set differs from the five supported workflows", errors)

    for path in skills:
        text = path.read_text(encoding="utf-8")
        frontmatter = re.match(r"\A---\n(.*?)\n---\n", text, re.DOTALL)
        if frontmatter is None:
            fail(f"missing skill frontmatter: {path.relative_to(ROOT)}", errors)
            continue
        header = frontmatter.group(1)
        name = re.search(r"^name: ([a-z0-9]+(?:-[a-z0-9]+)*)$", header, re.MULTILINE)
        if name is None or name.group(1) != path.parent.name:
            fail(f"Copilot skill name must match its directory: {path.relative_to(ROOT)}", errors)
        if not re.search(r"^description: \S[^\n]*$", header, re.MULTILINE):
            fail(f"missing single-line skill description: {path.relative_to(ROOT)}", errors)
        if not re.search(r"^disable-model-invocation: true$", header, re.MULTILINE):
            fail(f"Builder Kit skills must remain explicitly invoked: {path.relative_to(ROOT)}", errors)

    for path in sorted(plugin_root.rglob("*")):
        if not path.is_file() or path.suffix not in {".md", ".tmpl"}:
            continue
        for link in re.findall(r"\]\(([^)\s]+)\)", path.read_text(encoding="utf-8")):
            if link.startswith(("#", "//")) or re.match(r"^[A-Za-z][A-Za-z0-9+.-]*:", link):
                continue
            target = (path.parent / link.split("#", 1)[0]).resolve()
            if not target.is_relative_to(plugin_root) or not target.is_file():
                fail(f"missing or non-portable resource in {path.relative_to(ROOT)}: {link}", errors)


def check_builder_kit_standards(errors: list[str]) -> None:
    standards = ROOT / "plugins" / "builder-kit" / "references" / "standards"
    routing = standards / "routing.md"
    if not routing.is_file():
        fail("missing Builder Kit standards routing table", errors)
        return
    text = routing.read_text(encoding="utf-8")
    for path in sorted(standards.glob("*.md")):
        if path != routing and f"]({path.name})" not in text:
            fail(f"Builder Kit standard is not routed: {path.name}", errors)


def main() -> int:
    errors: list[str] = []
    claude = load_json(CLAUDE_MARKETPLACE, errors)
    codex = load_json(CODEX_MARKETPLACE, errors)

    if claude.get("name") != codex.get("name"):
        fail("Claude and Codex marketplace names differ", errors)

    claude_plugins = plugin_entries(claude, "Claude", errors)
    codex_plugins = plugin_entries(codex, "Codex", errors)
    if set(claude_plugins) != set(codex_plugins):
        fail("Claude and Codex marketplace plugin sets differ", errors)

    plugin_dirs = {path.name for path in (ROOT / "plugins").iterdir() if path.is_dir()}
    if plugin_dirs != set(claude_plugins):
        fail("registered plugins and plugin directories differ", errors)

    for name, claude_entry in claude_plugins.items():
        expected_path = f"./plugins/{name}"
        if claude_entry.get("source") != expected_path:
            fail(f"Claude source for {name} must be {expected_path}", errors)

        codex_entry = codex_plugins.get(name, {})
        source = codex_entry.get("source", {})
        if source.get("source") != "local" or source.get("path") != expected_path:
            fail(f"Codex source for {name} must be local at {expected_path}", errors)
        policy = codex_entry.get("policy", {})
        if policy.get("installation") not in {"AVAILABLE", "INSTALLED_BY_DEFAULT", "NOT_AVAILABLE"}:
            fail(f"Codex installation policy is invalid for {name}", errors)
        if policy.get("authentication") not in {"ON_INSTALL", "ON_USE"}:
            fail(f"Codex authentication policy is invalid for {name}", errors)

        plugin_root = ROOT / "plugins" / name
        if not plugin_root.is_dir():
            fail(f"plugin source does not exist: {plugin_root.relative_to(ROOT)}", errors)
            continue
        check_plugin(plugin_root, claude_entry.get("version"), errors)

    check_copilot_builder_kit(errors)
    check_builder_kit_standards(errors)
    check_gemini_extension(claude.get("name"), errors)

    if errors:
        print(f"\nFAIL: {len(errors)} marketplace validation error(s).")
        return 1
    print(f"OK: validated {len(claude_plugins)} portable plugin(s) for Codex and Claude Code, Copilot Builder Kit skills, and Gemini CLI extension surfaces.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
